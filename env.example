# Existing server configuration
DATABASE_URL=
TELEGRAM_BOT_TOKEN=
ADMIN_GROUP_CHAT_ID=

# Timeweb S3
S3_ENDPOINT=
S3_REGION=ru-1
S3_BUCKET=capy-print
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Permanent file URL prefix. Objects must allow public read in Timeweb.
# If empty, defaults to S3_ENDPOINT/S3_BUCKET/.
S3_PUBLIC_BASE_URL=

# Public application URLs
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_MINI_APP_URL=

# VK launch signature verification (server only)
VK_APP_ID=
VK_APP_SECRET=

# VK community messages (server only; numeric positive group ID)
# Use only the community ID: no minus, URL, or _post suffix from a wall link.
VK_GROUP_ID=
VK_GROUP_TOKEN=
# Staff recipients: full VK peer_id values, comma-separated; empty disables VK copies.
VK_ADMIN_PEER_IDS=

# Reserved for future webhook integration; not used yet
VK_CALLBACK_SECRET=
VK_CALLBACK_CONFIRMATION=
TELEGRAM_WEBHOOK_SECRET=
