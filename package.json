{
  "name": "capy-print",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "test": "node --import tsx --test tests/auth/*.test.ts",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:db:up": "docker compose up -d db",
    "docker:logs": "docker compose logs -f app",
    "docker:migrate": "docker compose exec app npm run db:migrate:deploy",
    "docker:seed": "docker compose exec app npm run db:seed",
    "postinstall": "prisma generate",
    "compile": "tsc -p ./tsconfig.json"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@mantine/core": "8.3.12",
    "@mantine/dates": "8.3.12",
    "@mantine/dropzone": "8.3.12",
    "@mantine/hooks": "8.3.12",
    "@mantine/modals": "8.3.12",
    "@prisma/adapter-pg": "^7.0.1",
    "@prisma/client": "^7.0.1",
    "@remixicon/react": "^4.7.0",
    "@tanstack/react-query": "^5.90.11",
    "@tma.js/init-data-node": "^2.0.8",
    "@tma.js/sdk-react": "^3.0.11",
    "@uploadthing/react": "^7.3.3",
    "@vkontakte/vk-bridge": "^2.15.12",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.19",
    "grammy": "^1.38.4",
    "lucide-react": "^0.555.0",
    "motion": "^14.1.0",
    "next": "16.0.10",
    "prisma": "^7.0.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.66.1",
    "react-hot-toast": "^2.6.0",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "uploadthing": "^7.7.4",
